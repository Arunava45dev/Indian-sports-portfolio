# Copy to .env and fill in. Atlas: Database > Connect > Drivers > copy the SRV string.
MONGODB_URI=replace-with-your-mongodb-atlas-connection-string
MONGODB_DB=sports_portfolio
ADMIN_TOKEN=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=your-groq-console-api-key
GROQ_MODEL=llama-3.3-70b-versatile
